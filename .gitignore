# --- Compilation & Build ---
# We use 'build' as the standard directory for CMake
build/
bin/
lib/
out/

# --- CMake ---
# These are generated by CMake and are local to your machine
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
Makefile
# This is a very important file for VS Code Intellisense
compile_commands.json

# --- Object Files & Binaries ---
*.o
*.a
*.so
*.out
# The final executable we defined in CMake


AGENT_IMPLEMENTATION.md
A's_guide.txt
session-ses_f9ef.md

