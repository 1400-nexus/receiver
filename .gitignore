# VS Code local settings
.vscode/
# If someone uses CLion or JetBrains
.idea/
*.swp
*.swo

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Uniflow Specific ---
# If you create local logs or test output files
*.log
